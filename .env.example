# Copy to .env at the repo root. Used by backend/ and database/ (node --env-file=../.env).
# The frontend needs no env vars: it always calls /api (Vite proxy in dev, Vercel rewrite in prod).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase -> Connect -> Session pooler (IPv4)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase -> Database settings -> SSL certificate (PEM, newlines as \n)
DATABASE_CA_CERT=

# Atlas -> Connect -> Drivers, using the least-privilege app user
MONGODB_URI=mongodb+srv://finsight_app:<password>@<cluster>.mongodb.net/finsight

# 64+ random bytes: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30m

# Comma-separated exact origins
CORS_ORIGINS=http://localhost:5173

# Proxy hops in front of the API (Vercel -> Render = 2); 0 locally
TRUST_PROXY_HOPS=0

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
