{
  "name": "finsight-fullstack",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "finsight-fullstack",
      "workspaces": [
        "frontend",
        "backend",
        "database"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "backend": {
      "name": "@finsight/backend"
    },
    "database": {
      "name": "@finsight/database"
    },
    "frontend": {
      "name": "@finsight/frontend"
    },
    "node_modules/@finsight/backend": {
      "resolved": "backend",
      "link": true
    },
    "node_modules/@finsight/database": {
      "resolved": "database",
      "link": true
    },
    "node_modules/@finsight/frontend": {
      "resolved": "frontend",
      "link": true
    }
  }
}
